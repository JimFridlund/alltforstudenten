# Viddra UK - Root .htaccess (COMPLETE)

<IfModule mime_module>
  AddHandler application/x-httpd-alt-php82___lsphp .php
</IfModule>

DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.viddra\.se$ [NC]
  RewriteRule ^(.*)$ https://viddra.se/$1 [L,R=301]

  RewriteRule ^install/ - [F,L]
</IfModule>
