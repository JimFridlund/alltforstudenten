RewriteEngine On

# ta bort trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# balen kategorier
RewriteRule ^balen/([^/]+)/?$ balen.php?kategori=$1 [L,QSA]

# sök
RewriteRule ^sok/?$ sok.php [L,QSA]

# visa kommun
RewriteRule ^visa/([^/]+)/([^/]+)/?$ visa.php?lan=$1&kommun=$2 [L,QSA]

# skola
RewriteRule ^skola/([^/]+)/?$ skola.php?slug=$1 [L,QSA]

# sitemap
RewriteRule ^sitemap.xml$ sitemap.xml [L]

# fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
